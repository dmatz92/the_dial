const YEAR_MIN = 1966, YEAR_MAX = 2026;
const MACRO_GENRES = ["Rock","Pop","Folk","Hip-Hop","Electronic","Funk & Soul","R&B","Metal","Punk",
  "Jazz","Country","Reggae","African","Middle Eastern","Classical","Latin","World","Other"];

function load(key, fallback){
  try{ const v = localStorage.getItem(key); return v ? JSON.parse(v) : fallback; }
  catch(e){ return fallback; }
}
function save(key, val){ localStorage.setItem(key, JSON.stringify(val)); }

let overrides = load('almanac_overrides', {});
let deleted = load('almanac_deleted', []);
let added = load('almanac_added', []);
let artCache = load('almanac_art_cache', {});

let ALBUMS = [];
let albumsByYear = {};

function rebuildAlbums(){
  ALBUMS = BASE_ALBUMS
    .filter(a => !deleted.includes(a.id))
    .map(a => overrides[a.id] ? Object.assign({}, a, overrides[a.id]) : a)
    .concat(added);
  albumsByYear = {};
  ALBUMS.forEach(a => { (albumsByYear[a.year] = albumsByYear[a.year] || []).push(a); });
}
rebuildAlbums();

const todayStr = () => {
  const d = new Date();
  return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
};

function formatDate(iso){
  if(!iso) return null;
  const parts = iso.split('-');
  const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  if(parts.length === 3) return months[parseInt(parts[1],10)-1] + ' ' + parseInt(parts[2],10) + ', ' + parts[0];
  if(parts.length === 2) return months[parseInt(parts[1],10)-1] + ' ' + parts[0];
  return parts[0];
}

let day = load('almanac_day', null);
if(!day || day.date !== todayStr()){
  const year = YEAR_MIN + Math.floor(Math.random() * (YEAR_MAX - YEAR_MIN + 1));
  day = { date: todayStr(), year: year, shown: [], current: null };
  save('almanac_day', day);
}

let log = load('almanac_log', []);
let selectedRating = 0;

function drawAlbum(excludeCurrent){
  const pool = albumsByYear[day.year] || [];
  if(pool.length === 0){ day.current = null; save('almanac_day', day); renderSpin(); return; }
  let candidates = pool;
  if(excludeCurrent && day.current && pool.length > 1){
    candidates = pool.filter(a => a.id !== day.current);
  }
  const pick = candidates[Math.floor(Math.random() * candidates.length)];
  day.current = pick.id;
  if(!day.shown.includes(pick.id)) day.shown.push(pick.id);
  save('almanac_day', day);
  resetForm();
  renderSpin();
}

function currentAlbum(){
  return ALBUMS.find(a => a.id === day.current) || null;
}

function resetForm(){
  selectedRating = 0;
  document.getElementById('fav-tracks').value = '';
  document.getElementById('review-text').value = '';
  document.getElementById('saved-note').classList.remove('show');
  paintStars();
}

function paintStars(){
  document.querySelectorAll('#stars button').forEach(b=>{
    b.classList.toggle('filled', Number(b.dataset.v) <= selectedRating);
  });
}

document.getElementById('stars').addEventListener('click', (e)=>{
  const btn = e.target.closest('button');
  if(!btn) return;
  selectedRating = Number(btn.dataset.v);
  paintStars();
});

function renderYearFacts(){
  const el = document.getElementById('year-facts');
  const items = FACTS[String(day.year)] || [];
  el.innerHTML = items.map(f => `<li>${f}</li>`).join('');
}

function fetchCoverArt(album){
  const artEl = document.querySelector('.record-art[data-album="' + album.id + '"]');
  if(!artEl) return;
  if(artCache[album.id]){
    if(artCache[album.id] !== 'none'){
      artEl.classList.add('has-cover');
      artEl.innerHTML = '<img src="' + artCache[album.id] + '" alt="">';
    }
    return;
  }
  const term = encodeURIComponent(album.artist + ' ' + album.title);
  fetch('https://itunes.apple.com/search?term=' + term + '&entity=album&limit=1')
    .then(r => r.ok ? r.json() : null)
    .then(data => {
      const hit = data && data.results && data.results[0];
      const url = hit ? hit.artworkUrl100.replace('100x100', '500x500') : null;
      artCache[album.id] = url || 'none';
      save('almanac_art_cache', artCache);
      const stillThere = document.querySelector('.record-art[data-album="' + album.id + '"]');
      if(url && stillThere){
        stillThere.classList.add('has-cover');
        stillThere.innerHTML = '<img src="' + url + '" alt="">';
      }
    })
    .catch(() => { /* offline or blocked — leave the vinyl placeholder */ });
}

function renderSpin(){
  document.getElementById('year-display').textContent = day.year;
  const pool = albumsByYear[day.year] || [];
  document.getElementById('year-count').textContent = pool.length + ' record' + (pool.length===1?'':'s') + ' catalogued for ' + day.year;
  renderYearFacts();

  const card = document.getElementById('record-card');
  const reviewCard = document.getElementById('review-card');
  const album = currentAlbum();

  if(!album){
    card.innerHTML = '<div class="empty-card">No album drawn yet for ' + day.year + '.<br><button class="big-btn" onclick="drawAlbum(false)">Draw a record</button></div>';
    reviewCard.style.display = 'none';
    return;
  }

  const dateLabel = formatDate(album.releaseDate) || (album.year + ' (exact date not on file)');

  const subTag = (album.genre && album.genre !== album.genreMacro)
    ? `<span class="subgenre-tag">${escapeHtml(album.genre)}</span>` : '';
  card.innerHTML = `
    <div class="record">
      <div class="record-art" data-album="${album.id}"></div>
      <div class="record-meta">
        <span class="genre-tag">${escapeHtml(album.genreMacro)}</span>${subTag}
        <h2>${escapeHtml(album.title)}</h2>
        <p class="artist">${escapeHtml(album.artist)}</p>
        <p class="release-date">Released ${dateLabel}</p>
      </div>
    </div>
    <div class="btn-row">
      <button class="ghost-btn" onclick="drawAlbum(true)">Different record from ${day.year}</button>
    </div>
  `;
  reviewCard.style.display = 'block';
  fetchCoverArt(album);
}

function saveEntry(){
  const album = currentAlbum();
  if(!album) return;
  const entry = {
    id: 'e' + Date.now(),
    dateListened: todayStr(),
    year: album.year,
    albumId: album.id,
    artist: album.artist,
    title: album.title,
    genre: album.genre,
    genreMacro: album.genreMacro,
    rating: selectedRating,
    favTracks: document.getElementById('fav-tracks').value.trim(),
    review: document.getElementById('review-text').value.trim()
  };
  log.unshift(entry);
  save('almanac_log', log);
  document.getElementById('saved-note').classList.add('show');
  drawAlbum(true);
}

function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function showTab(which){
  document.getElementById('tab-spin').classList.toggle('active', which==='spin');
  document.getElementById('tab-log').classList.toggle('active', which==='log');
  document.getElementById('tab-edit').classList.toggle('active', which==='edit');
  document.getElementById('view-spin').classList.toggle('active', which==='spin');
  document.getElementById('view-log').classList.toggle('active', which==='log');
  document.getElementById('view-edit').classList.toggle('active', which==='edit');
  if(which === 'log') renderLog();
  if(which === 'edit'){ populateMacroSelect(); renderEditList(); }
}

function renderLog(){
  const search = document.getElementById('log-search').value.trim().toLowerCase();
  const sortBy = document.getElementById('log-sort').value;

  let items = log.filter(e => {
    if(!search) return true;
    return (e.artist + ' ' + e.title).toLowerCase().includes(search);
  });

  items.sort((a,b) => {
    if(sortBy === 'date-desc') return a.dateListened < b.dateListened ? 1 : (a.dateListened > b.dateListened ? -1 : (b.id > a.id ? 1 : -1));
    if(sortBy === 'date-asc') return a.dateListened > b.dateListened ? 1 : -1;
    if(sortBy === 'year-desc') return b.year - a.year;
    if(sortBy === 'year-asc') return a.year - b.year;
    if(sortBy === 'rating-desc') return b.rating - a.rating;
    return 0;
  });

  const statsEl = document.getElementById('log-stats');
  const uniqueYears = new Set(log.map(e=>e.year)).size;
  const uniqueGenres = new Set(log.map(e=>e.genreMacro || e.genre)).size;
  statsEl.innerHTML = `
    <div><span class="n">${log.length}</span><br><span class="lab">Listened</span></div>
    <div><span class="n">${uniqueYears}</span><br><span class="lab">Years explored</span></div>
    <div><span class="n">${uniqueGenres}</span><br><span class="lab">Categories logged</span></div>
  `;

  const listEl = document.getElementById('log-list');
  if(items.length === 0){
    listEl.innerHTML = '<div class="no-entries">' + (log.length===0 ? 'Nothing logged yet &mdash; go spin a record.' : 'No entries match your search.') + '</div>';
    return;
  }
  listEl.innerHTML = items.map(e => {
    const macro = e.genreMacro || e.genre;
    const subTag = (e.genre && e.genre !== macro) ? `<span class="subgenre-tag">${escapeHtml(e.genre)}</span>` : '';
    return `
    <div class="entry">
      <div class="entry-top">
        <span class="entry-date">${e.dateListened}</span>
        <span class="entry-stars">${'\u2605'.repeat(e.rating)}${'\u2606'.repeat(5-e.rating)}</span>
      </div>
      <span class="genre-tag">${escapeHtml(macro)}</span>${subTag}
      <h3>${escapeHtml(e.title)}</h3>
      <p class="artist-year">${escapeHtml(e.artist)} &middot; ${e.year}</p>
      ${e.favTracks ? `<p class="fav"><b>Favorite:</b> ${escapeHtml(e.favTracks)}</p>` : ''}
      ${e.review ? `<p class="review">${escapeHtml(e.review)}</p>` : ''}
      <div class="btn-row"><button class="small-btn danger" onclick="deleteEntry('${e.id}')">remove entry</button></div>
    </div>
  `;
  }).join('');
}

function deleteEntry(id){
  if(!confirm('Remove this entry from your log?')) return;
  log = log.filter(e => e.id !== id);
  save('almanac_log', log);
  renderLog();
}

/* ---------- Edit Database ---------- */

function populateYearFilter(){
  const sel = document.getElementById('edit-year-filter');
  if(sel.options.length > 1) return;
  for(let y = YEAR_MAX; y >= YEAR_MIN; y--){
    const opt = document.createElement('option');
    opt.value = y; opt.textContent = y;
    sel.appendChild(opt);
  }
}

let editingId = null;

function renderEditList(){
  populateYearFilter();
  const yearFilter = document.getElementById('edit-year-filter').value;
  const search = document.getElementById('edit-search').value.trim().toLowerCase();

  let items = ALBUMS.filter(a => {
    if(yearFilter && String(a.year) !== yearFilter) return false;
    if(search && !(a.artist + ' ' + a.title).toLowerCase().includes(search)) return false;
    return true;
  }).sort((a,b) => b.year - a.year || a.artist.localeCompare(b.artist));

  const listEl = document.getElementById('edit-list');
  if(items.length === 0){
    listEl.innerHTML = '<div class="no-entries">No albums match.</div>';
    return;
  }

  listEl.innerHTML = items.map(a => {
    const isCustom = overrides[a.id] || a.id.startsWith('u');
    if(editingId === a.id){
      return `
        <div class="row-item editing" data-id="${a.id}">
          <input type="number" id="ef-year-${a.id}" value="${a.year}" min="${YEAR_MIN}" max="${YEAR_MAX}">
          <input type="text" id="ef-artist-${a.id}" value="${escapeAttr(a.artist)}">
          <input type="text" id="ef-title-${a.id}" value="${escapeAttr(a.title)}">
          <select id="ef-macro-${a.id}">${macroOptions(a.genreMacro)}</select>
          <input type="text" id="ef-genre-${a.id}" value="${escapeAttr(a.genre)}">
          <input type="date" id="ef-date-${a.id}" value="${a.releaseDate && a.releaseDate.length===10 ? a.releaseDate : ''}">
          <div class="row-actions">
            <button class="small-btn" onclick="saveEditRow('${a.id}')">Save</button>
            <button class="small-btn" onclick="editingId=null; renderEditList();">Cancel</button>
          </div>
        </div>`;
    }
    return `
      <div class="row-item" data-id="${a.id}">
        <span class="yr">${a.year}</span>
        <span>${escapeHtml(a.artist)}${isCustom ? '<span class="edit-badge">edited</span>' : ''}</span>
        <span>${escapeHtml(a.title)}</span>
        <span class="gn">${escapeHtml(a.genreMacro)}</span>
        <span class="gn" style="color:var(--ink-dim);">${escapeHtml(a.genre)}</span>
        <span class="rd">${a.releaseDate || '&mdash;'}</span>
        <div class="row-actions">
          <button class="small-btn" onclick="editingId='${a.id}'; renderEditList();">Edit</button>
          <button class="small-btn danger" onclick="deleteAlbum('${a.id}')">Delete</button>
        </div>
      </div>`;
  }).join('');
}

function escapeAttr(s){ return escapeHtml(s).replace(/`/g,'&#96;'); }

function macroOptions(selected){
  return MACRO_GENRES.map(m => `<option value="${m}"${m===selected?' selected':''}>${m}</option>`).join('');
}

function saveEditRow(id){
  const patch = {
    year: parseInt(document.getElementById('ef-year-'+id).value, 10),
    artist: document.getElementById('ef-artist-'+id).value.trim(),
    title: document.getElementById('ef-title-'+id).value.trim(),
    genreMacro: document.getElementById('ef-macro-'+id).value,
    genre: document.getElementById('ef-genre-'+id).value.trim(),
    releaseDate: document.getElementById('ef-date-'+id).value || null
  };
  if(id.startsWith('u')){
    added = added.map(a => a.id === id ? Object.assign({}, a, patch) : a);
    save('almanac_added', added);
  } else {
    overrides[id] = patch;
    save('almanac_overrides', overrides);
  }
  editingId = null;
  rebuildAlbums();
  renderEditList();
}

function deleteAlbum(id){
  if(!confirm('Remove this album from the database?')) return;
  if(id.startsWith('u')){
    added = added.filter(a => a.id !== id);
    save('almanac_added', added);
  } else {
    if(!deleted.includes(id)) deleted.push(id);
    save('almanac_deleted', deleted);
  }
  rebuildAlbums();
  if(day.current === id) drawAlbum(false);
  renderEditList();
}

function populateMacroSelect(){
  const sel = document.getElementById('new-macro');
  if(sel.options.length > 0) return;
  sel.innerHTML = macroOptions('Rock');
}

function addAlbum(){
  const year = parseInt(document.getElementById('new-year').value, 10);
  const artist = document.getElementById('new-artist').value.trim();
  const title = document.getElementById('new-title').value.trim();
  const genreMacro = document.getElementById('new-macro').value;
  const genre = document.getElementById('new-genre').value.trim();
  const releaseDate = document.getElementById('new-date').value || null;
  if(!year || year < YEAR_MIN || year > YEAR_MAX || !artist || !title){
    alert('Please fill in at least year (1966\u20132026), artist, and title.');
    return;
  }
  const newAlbum = { id: 'u' + Date.now(), year, artist, title, genreMacro, genre: genre || genreMacro, releaseDate };
  added.push(newAlbum);
  save('almanac_added', added);
  ['new-year','new-artist','new-title','new-genre','new-date'].forEach(id => document.getElementById(id).value = '');
  rebuildAlbums();
  renderEditList();
}

function resetEdits(){
  if(!confirm('This clears every edit, deletion, and added album you\'ve made, restoring the original database. Your listening log is not affected. Continue?')) return;
  overrides = {}; deleted = []; added = [];
  save('almanac_overrides', overrides);
  save('almanac_deleted', deleted);
  save('almanac_added', added);
  rebuildAlbums();
  renderEditList();
  renderSpin();
}

// init
if(!day.current || !ALBUMS.find(a=>a.id===day.current)) drawAlbum(false);
else renderSpin();
</script>
