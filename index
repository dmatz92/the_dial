<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Dial &mdash; a daily record spin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,500&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#efe6d3;
    --ink-dim:#b9ac91;
    --bg:#15130f;
    --bg-panel:#1e1b16;
    --bg-panel-2:#26221b;
    --line: #3a352b;
    --teal:#4f8b7a;
    --teal-dim:#3a6a5c;
    --gold:#d9a94c;
    --rust:#c2542f;
    --rust-dim:#8a3b21;
    --radius: 3px;
    --serif: 'Fraunces', Georgia, serif;
    --mono: 'IBM Plex Mono', 'Courier New', monospace;
  }
  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; }
  body{
    background:
      radial-gradient(ellipse 900px 500px at 15% -10%, rgba(217,169,76,0.08), transparent 60%),
      radial-gradient(ellipse 700px 500px at 100% 0%, rgba(79,139,122,0.10), transparent 55%),
      var(--bg);
    color:var(--ink);
    font-family: var(--serif);
    min-height:100vh;
    padding: 32px 20px 80px;
  }
  .wrap{ max-width: 780px; margin:0 auto; }

  header{ display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:26px; border-bottom:1px solid var(--line); padding-bottom:16px;}
  .brand{ display:flex; align-items:baseline; gap:12px;}
  .brand h1{ font-size:1.7rem; font-weight:700; margin:0; letter-spacing:.01em;}
  .brand .sub{ font-family:var(--mono); font-size:.68rem; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-dim); }
  nav{ display:flex; gap:4px; font-family:var(--mono); font-size:.72rem; text-transform:uppercase; letter-spacing:.08em; flex-wrap:wrap;}
  nav button{
    background:none; border:1px solid var(--line); color:var(--ink-dim);
    padding:8px 14px; border-radius:var(--radius); cursor:pointer;
  }
  nav button.active{ color:var(--bg); background:var(--gold); border-color:var(--gold); }
  nav button:not(.active):hover{ color:var(--ink); border-color:var(--ink-dim); }

  section{ display:none; }
  section.active{ display:block; animation: fadein .25s ease; }
  @keyframes fadein{ from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:translateY(0);} }

  .dial-row{ display:flex; align-items:center; gap:26px; margin-bottom: 16px; flex-wrap:wrap;}
  .dial{ flex:0 0 auto; }
  .dial svg{ display:block; }
  .dial-label{ font-family:var(--mono); }
  .dial-label .eyebrow{ font-size:.68rem; letter-spacing:.16em; text-transform:uppercase; color:var(--ink-dim); display:block; margin-bottom:6px;}
  .dial-label .year{ font-family:var(--serif); font-size:2.6rem; font-weight:700; color:var(--gold); line-height:1;}
  .dial-label .count{ font-size:.72rem; color:var(--ink-dim); margin-top:6px; }

  .year-facts{ list-style:none; margin: 0 0 22px; padding:0; font-family:var(--mono); font-size:.78rem; color:var(--ink-dim); line-height:1.7; border-left:2px solid var(--teal-dim); padding-left:14px;}
  .year-facts li::before{ content:"\2014  "; color:var(--teal); }

  .card{ background:var(--bg-panel); border:1px solid var(--line); border-radius:6px; padding:26px; margin-bottom:22px; }
  .empty-card{ text-align:center; padding:44px 20px; color:var(--ink-dim); font-family:var(--mono); font-size:.85rem; }
  .empty-card .big-btn{ margin-top:18px; }

  .record{ display:flex; gap:20px; align-items:center; }
  .record-art{
    flex:0 0 86px; width:86px; height:86px; border-radius:50%; overflow:hidden;
    background: repeating-radial-gradient(circle at center, #0c0b09 0 3px, #201c15 3px 6px);
    border:1px solid var(--line);
    position:relative;
  }
  .record-art::after{
    content:""; position:absolute; inset:0; margin:auto; width:20px; height:20px; border-radius:50%;
    background:var(--rust); box-shadow: inset 0 0 0 3px #15130f; pointer-events:none;
  }
  .record-art.has-cover::after{ display:none; }
  .record-art.has-cover{ background:none; }
  .record-art img{ width:100%; height:100%; object-fit:cover; display:block; }
  .record-art.spinning{ animation: spin 1.1s linear infinite; }
  @keyframes spin{ to{ transform: rotate(360deg); } }

  .record-meta .genre-tag{
    display:inline-block; font-family:var(--mono); font-size:.65rem; letter-spacing:.1em; text-transform:uppercase;
    color:var(--teal); border:1px solid var(--teal-dim); padding:3px 8px; border-radius:20px; margin-bottom:8px;
  }
  .record-meta .subgenre-tag{
    display:inline-block; font-family:var(--mono); font-size:.65rem; letter-spacing:.05em;
    color:var(--ink-dim); padding:3px 2px; margin-bottom:8px; margin-left:4px;
  }
  .record-meta h2{ margin:0 0 4px; font-size:1.4rem; line-height:1.25;}
  .record-meta .artist{ margin:0; color:var(--ink-dim); font-size:1rem; }
  .record-meta .release-date{ font-family:var(--mono); font-size:.68rem; color:var(--ink-dim); opacity:.8; margin-top:8px;}

  .btn-row{ display:flex; gap:10px; margin-top:20px; flex-wrap:wrap; }
  button.big-btn{
    font-family:var(--mono); text-transform:uppercase; letter-spacing:.08em; font-size:.78rem;
    background:var(--teal); color:#0e1512; border:none; padding:12px 18px; border-radius:var(--radius);
    cursor:pointer; font-weight:600;
  }
  button.big-btn:hover{ background:#5e9c8a; }
  button.ghost-btn{
    font-family:var(--mono); text-transform:uppercase; letter-spacing:.08em; font-size:.78rem;
    background:none; color:var(--ink-dim); border:1px solid var(--line); padding:12px 18px; border-radius:var(--radius);
    cursor:pointer;
  }
  button.ghost-btn:hover{ color:var(--ink); border-color:var(--ink-dim); }
  button.small-btn{
    font-family:var(--mono); text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;
    background:none; color:var(--ink-dim); border:1px solid var(--line); padding:6px 10px; border-radius:var(--radius); cursor:pointer;
  }
  button.small-btn:hover{ color:var(--ink); border-color:var(--ink-dim); }
  button.small-btn.danger:hover{ color:var(--rust); border-color:var(--rust-dim); }
  button:disabled{ opacity:.45; cursor:not-allowed; }

  .review-form label{ display:block; font-family:var(--mono); font-size:.7rem; text-transform:uppercase; letter-spacing:.1em; color:var(--ink-dim); margin: 18px 0 8px;}
  .review-form label:first-child{ margin-top:6px; }
  .stars{ display:flex; gap:6px; }
  .stars button{ background:none; border:none; font-size:1.6rem; line-height:1; cursor:pointer; color:var(--line); padding:0; }
  .stars button.filled{ color:var(--gold); }
  .stars button:hover{ color:var(--gold); }
  input[type=text], input[type=number], input[type=date], textarea, select{
    width:100%; background:var(--bg-panel-2); border:1px solid var(--line); color:var(--ink);
    font-family: var(--serif); font-size:.95rem; padding:10px 12px; border-radius:var(--radius); resize:vertical;
  }
  textarea{ min-height:80px; }
  input:focus, textarea:focus, select:focus, button:focus-visible{ outline: 2px solid var(--gold); outline-offset:2px; }

  .saved-note{ font-family:var(--mono); font-size:.75rem; color:var(--teal); margin-top:14px; display:none; }
  .saved-note.show{ display:block; }

  .log-stats{ display:flex; gap:26px; flex-wrap:wrap; margin-bottom:22px; font-family:var(--mono); }
  .log-stats .n{ font-family:var(--serif); font-size:1.6rem; color:var(--gold); font-weight:700; }
  .log-stats .lab{ font-size:.65rem; text-transform:uppercase; letter-spacing:.1em; color:var(--ink-dim); }

  .log-controls, .edit-controls{ display:flex; gap:10px; margin-bottom:18px; flex-wrap:wrap;}
  .log-controls input, .log-controls select, .edit-controls input, .edit-controls select{
    background:var(--bg-panel-2); border:1px solid var(--line); color:var(--ink); font-family:var(--mono);
    font-size:.78rem; padding:9px 11px; border-radius:var(--radius); width:auto;
  }

  .entry{ border:1px solid var(--line); border-radius:6px; background:var(--bg-panel); padding:18px 20px; margin-bottom:12px; }
  .entry-top{ display:flex; justify-content:space-between; align-items:baseline; gap:10px; flex-wrap:wrap; }
  .entry-date{ font-family:var(--mono); font-size:.68rem; color:var(--ink-dim); text-transform:uppercase; letter-spacing:.08em; }
  .entry-stars{ color:var(--gold); font-size:.85rem; letter-spacing:1px; }
  .entry h3{ margin:6px 0 2px; font-size:1.15rem; }
  .entry .artist-year{ color:var(--ink-dim); font-size:.88rem; margin:0 0 10px; }
  .entry .genre-tag{
    display:inline-block; font-family:var(--mono); font-size:.6rem; letter-spacing:.08em; text-transform:uppercase;
    color:var(--teal); border:1px solid var(--teal-dim); padding:2px 7px; border-radius:20px; margin-bottom:10px;
  }
  .entry .subgenre-tag{
    display:inline-block; font-family:var(--mono); font-size:.6rem; color:var(--ink-dim); margin-left:4px; margin-bottom:10px;
  }
  .entry .fav{ font-family:var(--mono); font-size:.78rem; color:var(--ink-dim); margin: 6px 0; }
  .entry .fav b{ color:var(--ink); font-weight:600; }
  .entry p.review{ margin: 8px 0 0; line-height:1.5; }
  .no-entries{ text-align:center; color:var(--ink-dim); font-family:var(--mono); padding:50px 0; font-size:.85rem; }

  /* edit database */
  .edit-intro{ font-family:var(--mono); font-size:.78rem; color:var(--ink-dim); line-height:1.6; margin-bottom:20px; }
  .add-form{ display:grid; grid-template-columns: 80px 1fr 1fr 130px 130px 140px auto; gap:8px; align-items:end; margin-bottom:10px;}
  .add-form label{ font-family:var(--mono); font-size:.62rem; text-transform:uppercase; letter-spacing:.06em; color:var(--ink-dim); display:block; margin-bottom:4px;}
  .row-list{ margin-top:8px; }
  .row-item{
    display:grid; grid-template-columns: 50px 1fr 1fr 100px 100px 110px auto; gap:8px; align-items:center;
    padding:10px 0; border-bottom:1px solid var(--line); font-size:.9rem;
  }
  .row-item .rlabel{ font-family:var(--mono); font-size:.6rem; text-transform:uppercase; color:var(--ink-dim); display:none; }
  .row-item.editing{ background:var(--bg-panel-2); border-radius:var(--radius); padding:10px; }
  .row-item .yr{ font-family:var(--mono); color:var(--ink-dim); }
  .row-item .gn{ font-family:var(--mono); font-size:.72rem; color:var(--teal); }
  .row-item .rd{ font-family:var(--mono); font-size:.72rem; color:var(--ink-dim); }
  .row-actions{ display:flex; gap:6px; }
  .edit-badge{ font-family:var(--mono); font-size:.6rem; color:var(--gold); margin-left:6px; }

  footer{ text-align:center; margin-top:50px; font-family:var(--mono); font-size:.65rem; color:var(--ink-dim); opacity:.6; }

  @media (max-width: 640px){
    .add-form, .row-item{ grid-template-columns: 1fr; }
    .row-item .rlabel{ display:inline; }
  }
  @media (max-width: 520px){
    .dial-row{ flex-direction:column; align-items:flex-start; }
    .record{ flex-direction:column; align-items:flex-start; }
    .log-stats{ gap:18px; }
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <div class="brand">
      <h1>The Dial</h1>
      <span class="sub">one record a day / 1966&ndash;2026</span>
    </div>
    <nav>
      <button id="tab-spin" class="active" onclick="showTab('spin')">Today's Spin</button>
      <button id="tab-log" onclick="showTab('log')">Listening Log</button>
      <button id="tab-edit" onclick="showTab('edit')">Edit Database</button>
    </nav>
  </header>

  <!-- SPIN VIEW -->
  <section id="view-spin" class="active">
    <div class="dial-row">
      <div class="dial">
        <svg width="92" height="92" viewBox="0 0 92 92">
          <circle cx="46" cy="46" r="43" fill="none" stroke="#3a352b" stroke-width="2"/>
          <circle cx="46" cy="46" r="43" fill="none" stroke="#d9a94c" stroke-width="2" stroke-dasharray="4 7" stroke-linecap="round"/>
          <circle cx="46" cy="46" r="4" fill="#c2542f"/>
        </svg>
      </div>
      <div class="dial-label">
        <span class="eyebrow">Today's year</span>
        <span class="year" id="year-display">&mdash;</span>
        <div class="count" id="year-count"></div>
      </div>
    </div>

    <ul class="year-facts" id="year-facts"></ul>

    <div class="card" id="record-card"></div>

    <div class="card" id="review-card" style="display:none;">
      <div class="review-form">
        <label>Rating</label>
        <div class="stars" id="stars">
          <button type="button" data-v="1">&#9733;</button>
          <button type="button" data-v="2">&#9733;</button>
          <button type="button" data-v="3">&#9733;</button>
          <button type="button" data-v="4">&#9733;</button>
          <button type="button" data-v="5">&#9733;</button>
        </div>
        <label for="fav-tracks">Favorite track(s)</label>
        <input type="text" id="fav-tracks" placeholder="e.g. track 3, the title track...">
        <label for="review-text">Notes / short review</label>
        <textarea id="review-text" placeholder="What stood out? What didn't land?"></textarea>
        <div class="btn-row">
          <button class="big-btn" onclick="saveEntry()">Log this listen</button>
        </div>
        <div class="saved-note" id="saved-note">Logged &mdash; a new record from this year is queued up above.</div>
      </div>
    </div>
  </section>

  <!-- LOG VIEW -->
  <section id="view-log">
    <div class="log-stats" id="log-stats"></div>
    <div class="log-controls">
      <input type="text" id="log-search" placeholder="search artist / album..." oninput="renderLog()">
      <select id="log-sort" onchange="renderLog()">
        <option value="date-desc">Newest listened</option>
        <option value="date-asc">Oldest listened</option>
        <option value="year-desc">Album year (new&rarr;old)</option>
        <option value="year-asc">Album year (old&rarr;new)</option>
        <option value="rating-desc">Highest rated</option>
      </select>
    </div>
    <div id="log-list"></div>
  </section>

  <!-- EDIT DATABASE VIEW -->
  <section id="view-edit">
    <p class="edit-intro">
      This is the full album database behind the tool &mdash; 431 records across 1966&ndash;2026.
      Fix a typo, correct a release date, remove something you don't want suggested, or add albums of your own.
      Everything here is saved to this browser only. <button class="small-btn danger" onclick="resetEdits()">Reset all my edits</button>
    </p>

    <div class="card">
      <label style="font-family:var(--mono);font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-dim);display:block;margin-bottom:10px;">Add an album</label>
      <div class="add-form">
        <div><label>Year</label><input type="number" id="new-year" min="1966" max="2026" placeholder="1994"></div>
        <div><label>Artist</label><input type="text" id="new-artist" placeholder="Nas"></div>
        <div><label>Title</label><input type="text" id="new-title" placeholder="Illmatic"></div>
        <div><label>Category</label><select id="new-macro"></select></div>
        <div><label>Subgenre</label><input type="text" id="new-genre" placeholder="e.g. East Coast Hip-Hop"></div>
        <div><label>Release date</label><input type="date" id="new-date"></div>
        <div><button class="big-btn" onclick="addAlbum()">Add</button></div>
      </div>
    </div>

    <div class="edit-controls">
      <select id="edit-year-filter" onchange="renderEditList()"><option value="">All years</option></select>
      <input type="text" id="edit-search" placeholder="search artist / album..." oninput="renderEditList()">
    </div>
    <div class="row-list" id="edit-list"></div>
  </section>

  <footer>your data lives only in this browser's local storage &mdash; nothing leaves this file</footer>
</div>

